{
  "name": "pi-ask-user",
  "version": "0.1.0",
  "description": "Interactive questionnaire tool for Pi. Asks single or multiple option questions in the TUI with optional custom input and process-local presence.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "keywords": [
    "pi-package",
    "pi",
    "ask-user",
    "questionnaire",
    "tui"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "main": "./index.ts",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "test": "bun test",
    "check": "bunx tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "ci": "bun run lint && bun run check && bun run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spi-ca/pi-ask-user.git"
  },
  "homepage": "https://github.com/spi-ca/pi-ask-user#readme",
  "bugs": "https://github.com/spi-ca/pi-ask-user/issues",
  "author": "Sangbum Kim <sangbumkim@amuz.es>",
  "files": [
    "index.ts",
    "src/**/*",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "docs/**/*.md",
    "LICENSE",
    "NOTICE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.1",
    "typebox": "1.1.38",
    "typescript": "^6.0.3"
  }
}
